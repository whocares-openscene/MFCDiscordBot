# Discord Bot Configuration
TOKEN=your_discord_bot_token
CLIENTID=your_discord_application_client_id

# HTTP API (optional). Leave LISTEN_ADDRESS unset/commented to run headless;
# the bot still monitors MFC and sends Discord notifications.
# LISTEN_ADDRESS=0.0.0.0:80
TIMEOUT_SECONDS=10
MAX_SNAPSHOT_SIZE=20000
WS_CONNECT_TIMEOUT=30s
WS_IDLE_TIMEOUT=30s
BULK_ARRIVAL_TIMEOUT=60s
RECONNECT_BACKOFF_MAX=1m
EXT_DATA_FETCH_TIMEOUT=30s
LOOKUP_TTL=5m
NAME_CACHE_TTL=24h
SNAPSHOT_COUNTS_LOG_EVERY=10m

# Online Check Interval
ONLINE_CHECK_INTERVAL=2m

# Database
DATABASE_PATH=mfcbot.db

# Debug / Trace
DEBUG=false
TRACE=false